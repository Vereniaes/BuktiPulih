# Frontend local settings - copy into .env.local and fill secrets privately.
# See planning/cloud-run-vercel-env-2026-10-28.md for production setup.
NEXT_PUBLIC_API_URL=/api/v1
BLOB_READ_WRITE_TOKEN=

# Legacy Vercel Cron only - not the fifteen-minute Cloud Scheduler worker.
CRON_SECRET=

# Optional store metadata - no current application reader.
Karhutla_STORE_ID=

# Server-side upstream for the same-origin API proxy.
API_UPSTREAM_URL=http://localhost:5000/api/v1

# Browser key - restrict websites and the Maps JavaScript, Places (New), Geocoding APIs.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
# Advanced marker map ID; local development can use DEMO_MAP_ID.
NEXT_PUBLIC_GOOGLE_MAPS_MAP_ID=
